# KrishiAI AI/ML/DL Service Configuration
APP_NAME=KrishiAI-ML-Service
APP_ENV=development
PORT=8000

# Model execution mode:
#   auto        -> Try local HuggingFace weights (GPU/CPU) -> Free HF Inference API (if HF_TOKEN set) -> Grounded local CV/RAG fallback
#   local       -> Load HuggingFace weights locally via transformers/torch
#   hf_api      -> Use free HuggingFace Inference Router API (requires free HF_TOKEN)
#   lightweight -> Fast zero-GPU mode using local CV lesion analyzer + RAG KB + trained scikit-learn/NumPy ML models
MODEL_MODE=auto

# Optional: Free HuggingFace access token (https://huggingface.co/settings/tokens)
# Used for gated models or free HuggingFace Inference API routing
HF_TOKEN=

# HuggingFace Model IDs (Pretrained)
DISEASE_MODEL_PRIMARY=Saon110/bd-crop-vegetable-plant-disease-model
DISEASE_MODEL_SECONDARY=rarfileexe/Plant-Disease-Detector
SCHEMES_LLM_MODEL=bharatgenai/AgriParam
CHEMICAL_LLM_MODEL=me-nabi/farmer-advisory-hindi-qwen2.5-3b

# Local Paths
MANDI_DATASET_PATH=./data/mandi_sample.csv
MODELS_STORE_DIR=./models_store
HF_CACHE_DIR=./.hf_cache
